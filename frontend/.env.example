# Frontend Environment Variables
# Salin file ini menjadi .env.local (tidak ikut ter-commit) lalu isi nilainya.
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Base URL backend API
# ---------------------------------------------------------------------------
# Kosongkan (atau hapus) saat development: request akan lewat proxy Vite
# (lihat vite.config.js) ke http://localhost:3000.
# Isi saat production (Vercel): URL backend Railway/Render, TANPA trailing slash.
#   VITE_API_URL=https://ai-multimodal-backend.up.railway.app
VITE_API_URL=

# ---------------------------------------------------------------------------
# Firebase Web App config
# Firebase Console -> Project Settings -> Your apps -> SDK setup and configuration
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
