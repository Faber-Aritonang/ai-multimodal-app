# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
frontend/dist/
backend/build/

# Environment
# `.env*` sudah menutup seluruh varian rahasia sekaligus: .env, .env.local,
# .env.production, .env.bak, .env.save, dst. Jadi tidak perlu didaftar satu per
# satu. Hanya berkas contoh yang boleh ter-commit karena isinya placeholder.
.env*
!.env.example

# Kunci privat, sertifikat, dan kredensial service account.
# Ini hanya lapisan pertama: aturan ignore tidak berlaku pada berkas yang sudah
# ter-track dan tidak menahan `git add -f`. Penjagaan yang sebenarnya ada di
# scripts/check-no-secrets.js (dipanggil hook pre-commit dan job quality di CI).
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
*service-account*.json
*firebase-adminsdk*.json
*client_secret*.json
.railway-token
railway-token*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Firebase config
backend/config/firebase-service-account.json

# Hasil generate media (image/video/audio)
backend/uploads/

# Cache
.cache/
.temp/
.npm-cache/

# Metadata project Vercel (ditulis oleh `vercel pull`, bukan sumber kode)
.vercel/

# Salinan repo yang tertinggal di dalam working tree. Folder ini punya `.git`
# sendiri sehingga sempat ter-track sebagai gitlink, padahal isinya duplikat
# dari repo utama. Jangan commit sebagai embedded repo.
ai-multimodal-app-clean/

# Testing
coverage/
.nyc_output/
