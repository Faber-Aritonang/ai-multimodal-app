# Backend Environment Variables
# Salin file ini menjadi .env (tidak ikut ter-commit) lalu isi nilainya.
#   cp .env.example .env
# Panduan lengkap: docs/setup-kredensial.md

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (untuk CORS)
# Development: http://localhost:5173
# Production : URL Vercel, mis. https://ai-multimodal-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas free tier atau MongoDB lokal)
MONGODB_URI=mongodb://localhost:27017/ai-multimodal

# JWT Secret (generate: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Firebase Service Account (pilih salah satu format):
#   1. JSON string langsung (produksi, mis. Railway secret):
#      FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
#   2. Path ke file service account (lokal):
FIREBASE_SERVICE_ACCOUNT=./config/firebase-service-account.json

# Seed admin (dipakai oleh `npm run seed:admin`)
# Isi uid dengan Firebase UID akun Google yang akan dijadikan admin.
# ADMIN_UID=<firebase-uid>
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME="Admin"

# AI API Keys
# Tanpa key apa pun server tetap berjalan; hanya endpoint AI yang menolak request.
OPENAI_API_KEY=sk-your-openai-key-here
# Model chat OpenAI (opsional, default gpt-3.5-turbo)
# OPENAI_CHAT_MODEL=gpt-3.5-turbo
# Model text-to-image OpenAI (opsional, default dall-e-3)
# OPENAI_IMAGE_MODEL=dall-e-3

# --- Chat (LLM): provider ---
# Provider utama: groq | gemini | openai | openrouter
# Default tanpa diisi: provider pertama yang punya API key, urut groq -> gemini
# -> openai -> openrouter.
# CHAT_PROVIDER=groq
# Fallback saat provider utama gagal/kuotanya habis:
# groq | gemini | openai | openrouter | none   (default: provider lain yang punya key)
# Boleh lebih dari satu, dipisah koma dan dicoba berurutan, mis. gemini,openrouter.
# Nama yang ditulis di sini didahulukan; provider lain yang key-nya sudah diisi
# tetap ikut di belakangnya (menambah key tidak pernah diam). Hanya `none` yang
# benar-benar mematikan cadangan.
# CHAT_FALLBACK_PROVIDER=none
# Batas token keluaran per balasan (default 2000)
# CHAT_MAX_TOKENS=2000
# Batas waktu satu request ke provider (default 90000 ms). Free tier Gemini
# terukur 17-60 detik, Groq < 1 detik.
# CHAT_REQUEST_TIMEOUT_MS=90000

# Groq - GRATIS tanpa kartu kredit (30 req/menit, 1.000 req/hari, 200K token/hari).
# Key: https://console.groq.com/keys
# GROQ_API_KEY=gsk-your-groq-key-here
# Model gratis: openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.8-27b,
#               groq/compound (agentic + web search)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Google Gemini - free tier paling longgar (konten dipakai Google di tier gratis).
# Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_CHAT_MODEL=gemini-3.8-flash

# OpenRouter - gateway ke banyak model; model berakhiran `:free` tidak berbayar
# (tetapi punya rate limit harian). Dipakai sebagai provider CADANGAN: selama
# OPENROUTER_API_KEY kosong, provider ini dilewati dan rantai cadangan lama tidak
# berubah. Key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your-openrouter-key-here
# Boleh beberapa model dipisah koma: dicoba berurutan, karena batas gratis
# OpenRouter berlaku per model. Default (tanpa diisi):
#   nex-agi/nex-n2.5-mini:free              -> ±0,7-1,0 detik (tercepat)
#   nvidia/nemotron-3-super-120b-a12b:free  -> ±5,0-6,3 detik (cadangan)
#   inclusionai/ling-3.0-flash-vl:free      -> ±1,0-1,9 detik (cadangan)
#   inclusionai/ling-3.0-flash-fin:free     -> ±0,8-2,3 detik (cadangan terakhir)
# z-ai/glm-5.2:free dikeluarkan dari default: selalu 429 karena kolam gratis
# bersama provider upstreamnya ("Decart") jenuh. Bisa dipasang lagi lewat env ini
# begitu longgar. Detail: docs/setup-kredensial.md bagian 3c
# Hasil pembandingan model gratis: docs/setup-kredensial.md bagian 3c.
# OPENROUTER_CHAT_MODEL=nex-agi/nex-n2.5-mini:free,nvidia/nemotron-3-super-120b-a12b:free,inclusionai/ling-3.0-flash-vl:free,inclusionai/ling-3.0-flash-fin:free
# Model ini bisa berpikir (reasoning): kalau dibiarkan, jatah CHAT_MAX_TOKENS
# habis untuk berpikir dan jawaban yang sampai ke user hanya jejak berpikir
# ("Here's a thinking process: ...") — dan satu balasan bisa memakan ±100 detik.
# Karena itu penalaran dimatikan secara default:
#   off (default) -> reasoning dimatikan, jawaban bersih & tercepat
#   exclude       -> model tetap berpikir tapi jejaknya disembunyikan
#   default       -> tidak mengirim parameter apa pun (ikut perilaku model)
# OPENROUTER_REASONING=off
# Jeda sebelum model yang baru gagal dicoba lagi (ms). Selama jeda, model itu
# dilewati tanpa request, jadi kegagalan yang sama tidak dibayar berulang kali.
# Jeda dihapus begitu model tersebut berhasil lagi. 0 = selalu coba semua model.
# OPENROUTER_FAILURE_COOLDOWN_MS=60000

# --- Text-to-Image: provider ---
# Provider utama: bynara | cloudflare | pollinations | openai
# Default (tanpa diisi): bynara bila kuncinya ada, lalu cloudflare bila
# kredensialnya ada, lalu openai bila ada key-nya, terakhir pollinations.
# IMAGE_PROVIDER=bynara
# Provider cadangan saat provider utama belum siap / gagal / kuota habis:
# bynara | cloudflare | pollinations | openai | none  (default: pollinations)
# IMAGE_FALLBACK_PROVIDER=pollinations
# Batas waktu satu request ke provider (ms)
# IMAGE_REQUEST_TIMEOUT_MS=120000

# Cloudflare Workers AI — GRATIS 10.000 Neurons/hari, tanpa kartu kredit.
# FLUX.1 [schnell] ±154 neurons per gambar 1024x1024 (≈65 gambar/hari).
# Ambil Account ID di dashboard Workers AI, dan buat API token (template:
# "Workers AI") di https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Model & jumlah step (opsional)
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=4

# Pollinations — gratis tanpa API key (dipakai sebagai fallback default).
# Token opsional hanya menaikkan limit.
# POLLINATIONS_TOKEN=your-pollinations-token
# POLLINATIONS_MODEL=flux
# POLLINATIONS_BASE_URL=https://image.pollinations.ai
# Model yang dicoba berurutan saat satu model kena batas laju per-model.
# `none` mematikan rotasi; POLLINATIONS_ATTEMPTS membatasi jumlah percobaan.
# POLLINATIONS_FALLBACK_MODELS=turbo,flux-realism
# POLLINATIONS_ATTEMPTS=3

# Bynara (NaraRouter) — Agnes Image 2.0 Flash lewat gateway OpenAI-compatible.
# Kunci dari dashboard NaraRouter (berawalan `sk-nry-`). Satu kunci ini cukup:
# host generate (api-images) dan host unduhan hasil (router) sudah punya nilai
# bawaan yang benar.
# BYNARA_API_KEY=sk-nry-...
# BYNARA_BASE_URL=https://api-images.bynara.id/v1
# BYNARA_DOWNLOAD_BASE_URL=https://router.bynara.id
# BYNARA_IMAGE_MODEL=agnes-image-2.0-flash

# --- Image-to-Image: provider ---
# Provider utama: bynara | cloudflare
# Default (tanpa diisi): bynara bila kuncinya ada, lalu cloudflare.
# IMAGE_EDIT_PROVIDER=bynara
# Provider cadangan: bynara | cloudflare | none  (default: cloudflare)
# IMAGE_EDIT_FALLBACK_PROVIDER=cloudflare
#
# Pollinations sengaja TIDAK ada di daftar ini. Ia memang menerima parameter
# `image=`, tapi hasilnya sering hanya gambar baru dari prompt, dan saat URL
# input tidak terjangkau ia tetap membalas 200 seolah berhasil. Kedua provider
# di atas bekerja dari bytes gambar yang diunggah, jadi hasilnya benar-benar
# bersandar pada gambar input.
#
# Cloudflare Workers AI memakai FLUX.2 [klein] untuk mengedit gambar. Model ini
# WAJIB multipart dan hanya menerima gambar input < 512x512 (frontend memperkecil
# otomatis). Perkiraan kuota: ±110 neurons per gambar 1024x1024 -> ±90 gambar/hari
# dari jatah gratis 10.000 neurons/hari. Kredensialnya sama dengan text-to-image
# (CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN di atas).
# CLOUDFLARE_EDIT_MODEL=@cf/black-forest-labs/flux-2-klein-4b
#
# Bynara memakai endpoint edit yang sama dengan generasi (OpenAI-compatible di
# api-images.bynara.id/v1/images/edits), dan hanya menerima multipart dengan
# `image` sebagai berkas. Kredensialnya sama dengan text-to-image di atas.
#
# PUBLIC_BASE_URL hanya dipakai aplikasi ini untuk menyusun tautan berkas saat
# penyimpanan lokal; provider edit tidak lagi mengambil gambar lewat URL, jadi
# image-to-image tidak membutuhkannya.
# PUBLIC_BASE_URL=https://aplikasi-anda.example.com

# --- Text-to-Sound (TTS): provider ---
# Urutan/provider: gemini | edge | elevenlabs | openai | none
# Default tanpa diisi: provider pertama yang kredensialnya tersedia, urut
# Gemini -> ElevenLabs -> OpenAI -> Edge, dengan cadangan Edge.
# Yang dipakai untuk teks INDONESIA dan gratis:
#   Edge TTS     — suara neural Indonesia bawaan Microsoft. TIDAK BUTUH KUNCI
#                  APA PUN, jadi fitur ini hidup tanpa isi .env sama sekali.
#                  Karena itu pula ia jadi cadangan default: cadangan yang butuh
#                  kunci akan gagal tepat saat paling dibutuhkan. Hanya MP3.
#   Gemini TTS   — kuota gratis tanpa billing, suara 70+ bahasa termasuk Indonesia,
#                  logat bisa diarahkan lewat kolom "voice style". Hanya WAV.
#   ElevenLabs   — free tier 10.000 karakter/bulan; dipakai bila dipilih manual.
# OpenAI tetap tersedia tetapi tidak lagi dipakai otomatis (berbayar).
# Provider MiMo (Xiaomi) pernah ada di sini dan sudah DIHAPUS: dokumentasi
# resminya hanya menyebut Mandarin + Inggris, sedangkan halaman text-to-sound
# selalu mengucapkan teks Indonesia. Jangan tambahkan MIMO_API_KEY lagi —
# variabel itu tidak dibaca oleh kode saat ini.
# SOUND_PROVIDER=gemini
# SOUND_FALLBACK_PROVIDER=edge
# Batas waktu satu request ke provider (ms). Sintesis suara lebih lama dari chat.
# SOUND_REQUEST_TIMEOUT_MS=120000
#
# Edge TTS memakai endpoint Read Aloud milik Microsoft yang tidak didokumentasikan
# sebagai API publik — gratis dan tanpa akun, tetapi bisa berubah sewaktu-waktu.
# Matikan dengan SOUND_PROVIDER=none bila tidak ingin dipakai; alamatnya bisa
# ditimpa lewat EDGE_TTS_WSS_URL bila Microsoft memindahkannya.
# EDGE_TTS_WSS_URL=
#
# Google Gemini TTS — endpoint /v1beta/interactions, hasilnya PCM mentah yang
# dibungkus WAV oleh backend (karena itu provider ini hanya menawarkan WAV).
# Kuncinya sama dengan provider chat Gemini di atas; ambil di
# https://aistudio.google.com/apikey — kuota gratisnya TIDAK butuh billing.
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
#
# ElevenLabs — model eleven_multilingual_v2 (mendukung Bahasa Indonesia).
# Free tier: 10.000 karakter/bulan, API boleh dipakai, tanpa kartu kredit.
# Kunci: https://elevenlabs.io/app/settings/api-keys
# ID voice dibaca dari akun pemilik kunci (GET /v1/voices), karena free tier
# tidak boleh memakai voice library dan daftar voice bawaan berbeda per akun.
# Isi ELEVENLABS_VOICE_ID kalau ingin memaksa voice tertentu.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=
#
# OpenAI TTS (opsional, berbayar) — endpoint /v1/audio/speech. Model
# `gpt-4o-mini-tts` menerima parameter `instructions`, jadi kolom "voice style"
# dipakai BERSAMA voice yang dipilih. Pada `tts-1`/`tts-1-hd` parameter itu tidak
# ada dan gaya suara diabaikan.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Folder penyimpanan hasil generate media (default: backend/uploads)
# UPLOAD_DIR=uploads

# --- Sound-to-Text (transkripsi): provider ---
# Urutan/provider: groq | gemini | openai | none
# Default tanpa diisi: provider pertama yang kredensialnya tersedia, urut
# Groq -> Gemini -> OpenAI, dengan cadangan Gemini.
#
# Beda dari text-to-sound yang punya Edge (tanpa kunci sama sekali), di sini
# TIDAK ADA provider yang bisa dipakai tanpa akun — jadi fitur ini memang tidak
# jalan di mesin kosong. Itu disengaja dan pesannya jelas (503 yang menyebut
# variabel yang harus diisi), bukan kegagalan senyap.
#   Groq    — whisper-large-v3. GRATIS 1.000 request/hari, jawab < 2 detik.
#             Kuncinya sama dengan provider chat di atas.
#   Gemini  — audio dikirim inline ke generateContent. Kuncinya sama dengan
#             chat/TTS. Cadangan defaultnya, jadi mesin yang sudah mengisi
#             GEMINI_API_KEY untuk fitur lain langsung bisa memakai fitur ini.
#   OpenAI  — whisper-1 / gpt-4o-transcribe. Berbayar, jadi TIDAK pernah dipakai
#             otomatis; hanya bila diminta lewat STT_PROVIDER=openai.
# STT_PROVIDER=groq
# STT_FALLBACK_PROVIDER=gemini
# Bahasa default transkripsi (id | en | auto | kode 2-3 huruf lainnya).
# STT_DEFAULT_LANGUAGE=id
# Batas waktu satu request ke provider (ms).
# STT_REQUEST_TIMEOUT_MS=120000
# Model per provider (opsional, semuanya punya default):
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3
# GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Rate Limiting
# Jaring pengaman terhadap penyalahgunaan, bukan pembatas per fitur. Batasnya
# harus longgar: sekali buka dashboard frontend sudah memanggil beberapa
# endpoint sekaligus, dan kuota per user (chat/gambar) yang membatasi pemakaian
# sebenarnya. Terlalu ketat -> aplikasi menolak dirinya sendiri dengan 429.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
