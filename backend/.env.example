# Backend Environment Variables
# Salin file ini menjadi .env (tidak ikut ter-commit) lalu isi nilainya.
#   cp .env.example .env
# Panduan lengkap: docs/setup-kredensial.md

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (untuk CORS)
# Development: http://localhost:5173
# Production : URL Vercel, mis. https://ai-multimodal-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas free tier atau MongoDB lokal)
MONGODB_URI=mongodb://localhost:27017/ai-multimodal

# JWT Secret (generate: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Firebase Service Account (pilih salah satu format):
#   1. JSON string langsung (produksi, mis. Railway secret):
#      FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
#   2. Path ke file service account (lokal):
FIREBASE_SERVICE_ACCOUNT=./config/firebase-service-account.json

# Seed admin (dipakai oleh `npm run seed:admin`)
# Isi uid dengan Firebase UID akun Google yang akan dijadikan admin.
# ADMIN_UID=<firebase-uid>
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME="Admin"

# AI API Keys
# Tanpa key apa pun server tetap berjalan; hanya endpoint AI yang menolak request.
OPENAI_API_KEY=sk-your-openai-key-here
# Model chat OpenAI (opsional, default gpt-3.5-turbo)
# OPENAI_CHAT_MODEL=gpt-3.5-turbo
# Model text-to-image OpenAI (opsional, default dall-e-3)
# OPENAI_IMAGE_MODEL=dall-e-3

# --- Chat (LLM): provider ---
# Provider utama: groq | gemini | openai | openrouter
# Default tanpa diisi: provider pertama yang punya API key, urut groq -> gemini
# -> openai -> openrouter.
# CHAT_PROVIDER=groq
# Fallback saat provider utama gagal/kuotanya habis:
# groq | gemini | openai | openrouter | none   (default: provider lain yang punya key)
# Boleh lebih dari satu, dipisah koma dan dicoba berurutan, mis. gemini,openrouter.
# Nama yang ditulis di sini didahulukan; provider lain yang key-nya sudah diisi
# tetap ikut di belakangnya (menambah key tidak pernah diam). Hanya `none` yang
# benar-benar mematikan cadangan.
# CHAT_FALLBACK_PROVIDER=none
# Batas token keluaran per balasan (default 2000)
# CHAT_MAX_TOKENS=2000
# Batas waktu satu request ke provider (default 90000 ms). Free tier Gemini
# terukur 17-60 detik, Groq < 1 detik.
# CHAT_REQUEST_TIMEOUT_MS=90000

# Groq - GRATIS tanpa kartu kredit (30 req/menit, 1.000 req/hari, 200K token/hari).
# Key: https://console.groq.com/keys
# GROQ_API_KEY=gsk-your-groq-key-here
# Model gratis: openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.8-27b,
#               groq/compound (agentic + web search)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Google Gemini - free tier paling longgar (konten dipakai Google di tier gratis).
# Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_CHAT_MODEL=gemini-3.8-flash

# OpenRouter - gateway ke banyak model; model berakhiran `:free` tidak berbayar
# (tetapi punya rate limit harian). Dipakai sebagai provider CADANGAN: selama
# OPENROUTER_API_KEY kosong, provider ini dilewati dan rantai cadangan lama tidak
# berubah. Key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your-openrouter-key-here
# Boleh beberapa model dipisah koma: dicoba berurutan, karena batas gratis
# OpenRouter berlaku per model. Default (tanpa diisi):
#   nex-agi/nex-n2.5-mini:free              -> ±0,7-1,0 detik (tercepat)
#   nvidia/nemotron-3-super-120b-a12b:free  -> ±5,0-6,3 detik (cadangan)
#   inclusionai/ling-3.0-flash-vl:free      -> ±1,0-1,9 detik (cadangan)
#   inclusionai/ling-3.0-flash-fin:free     -> ±0,8-2,3 detik (cadangan terakhir)
# z-ai/glm-5.2:free dikeluarkan dari default: selalu 429 karena kolam gratis
# bersama provider upstreamnya ("Decart") jenuh. Bisa dipasang lagi lewat env ini
# begitu longgar. Detail: docs/setup-kredensial.md bagian 3c
# Hasil pembandingan model gratis: docs/setup-kredensial.md bagian 3c.
# OPENROUTER_CHAT_MODEL=nex-agi/nex-n2.5-mini:free,nvidia/nemotron-3-super-120b-a12b:free,inclusionai/ling-3.0-flash-vl:free,inclusionai/ling-3.0-flash-fin:free
# Model ini bisa berpikir (reasoning): kalau dibiarkan, jatah CHAT_MAX_TOKENS
# habis untuk berpikir dan jawaban yang sampai ke user hanya jejak berpikir
# ("Here's a thinking process: ...") — dan satu balasan bisa memakan ±100 detik.
# Karena itu penalaran dimatikan secara default:
#   off (default) -> reasoning dimatikan, jawaban bersih & tercepat
#   exclude       -> model tetap berpikir tapi jejaknya disembunyikan
#   default       -> tidak mengirim parameter apa pun (ikut perilaku model)
# OPENROUTER_REASONING=off
# Jeda sebelum model yang baru gagal dicoba lagi (ms). Selama jeda, model itu
# dilewati tanpa request, jadi kegagalan yang sama tidak dibayar berulang kali.
# Jeda dihapus begitu model tersebut berhasil lagi. 0 = selalu coba semua model.
# OPENROUTER_FAILURE_COOLDOWN_MS=60000

# --- Text-to-Image: provider ---
# Provider utama: cloudflare | pollinations | openai
# Default (tanpa diisi): cloudflare bila kredensialnya ada, lalu openai bila ada
# key-nya, terakhir pollinations().
# IMAGE_PROVIDER=cloudflare
# Provider cadangan saat provider utama belum siap / gagal / kuota habis:
# cloudflare | pollinations | openai | none  (default: pollinations)
# IMAGE_FALLBACK_PROVIDER=pollinations
# Batas waktu satu request ke provider (ms)
# IMAGE_REQUEST_TIMEOUT_MS=120000

# Cloudflare Workers AI — GRATIS 10.000 Neurons/hari, tanpa kartu kredit.
# FLUX.1 [schnell] ±154 neurons per gambar 1024x1024 (≈65 gambar/hari).
# Ambil Account ID di dashboard Workers AI, dan buat API token (template:
# "Workers AI") di https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Model & jumlah step (opsional)
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=4

# Pollinations — gratis tanpa API key (dipakai sebagai fallback default).
# Token opsional hanya menaikkan limit.
# POLLINATIONS_TOKEN=your-pollinations-token
# POLLINATIONS_MODEL=flux
# POLLINATIONS_BASE_URL=https://image.pollinations.ai

# --- Image-to-Image: provider ---
# Provider utama: cloudflare | pollinations
# Default (tanpa diisi): cloudflare bila kredensialnya ada, terakhir pollinations.
# IMAGE_EDIT_PROVIDER=cloudflare
# Provider cadangan: cloudflare | pollinations | none  (default: pollinations)
# IMAGE_EDIT_FALLBACK_PROVIDER=pollinations
#
# Cloudflare Workers AI memakai FLUX.2 [klein] untuk mengedit gambar. Model ini
# WAJIB multipart dan hanya menerima gambar input < 512x512 (frontend memperkecil
# otomatis). Perkiraan kuota: ±110 neurons per gambar 1024x1024 -> ±90 gambar/hari
# dari jatah gratis 10.000 neurons/hari. Kredensialnya sama dengan text-to-image
# (CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN di atas).
# CLOUDFLARE_EDIT_MODEL=@cf/black-forest-labs/flux-2-klein-4b
#
# Pollinations bisa dipakai untuk edit TANPA API key, TAPI hanya kalau gambar
# input punya URL yang bisa diakses publik. PENTING: kalau URL-nya tidak
# terjangkau, Pollinations tetap membalas 200 dan menghasilkan gambar dari
# prompt saja (input diabaikan tanpa error) — karena itu jalur ini hanya aktif
# bila PUBLIC_BASE_URL diisi, supaya user tidak menerima "hasil edit" palsu.
# PUBLIC_BASE_URL=https://aplikasi-anda.example.com

# Folder penyimpanan hasil generate media (default: backend/uploads)
# UPLOAD_DIR=uploads

# Key untuk fitur media (belum diimplementasi, siapkan jika perlu)
# ELEVENLABS_API_KEY=your-elevenlabs-key-here
# HUGGINGFACE_API_KEY=hf-your-huggingface-key-here

# Rate Limiting
# Jaring pengaman terhadap penyalahgunaan, bukan pembatas per fitur. Batasnya
# harus longgar: sekali buka dashboard frontend sudah memanggil beberapa
# endpoint sekaligus, dan kuota per user (chat/gambar) yang membatasi pemakaian
# sebenarnya. Terlalu ketat -> aplikasi menolak dirinya sendiri dengan 429.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
