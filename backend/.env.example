# Backend Environment Variables
# Salin file ini menjadi .env (tidak ikut ter-commit) lalu isi nilainya.
#   cp .env.example .env
# Panduan lengkap: docs/setup-kredensial.md

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (untuk CORS)
# Development: http://localhost:5173
# Production : URL Vercel, mis. https://ai-multimodal-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas free tier atau MongoDB lokal)
MONGODB_URI=mongodb://localhost:27017/ai-multimodal

# JWT Secret (generate: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Firebase Service Account (pilih salah satu format):
#   1. JSON string langsung (produksi, mis. Railway secret):
#      FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
#   2. Path ke file service account (lokal):
FIREBASE_SERVICE_ACCOUNT=./config/firebase-service-account.json

# Seed admin (dipakai oleh `npm run seed:admin`)
# Isi uid dengan Firebase UID akun Google yang akan dijadikan admin.
# ADMIN_UID=<firebase-uid>
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME="Admin"

# AI API Keys
# OPENAI_API_KEY wajib untuk fitur chat (/api/v1/member/chat/...).
# Tanpa key ini server tetap berjalan, hanya endpoint chat yang menolak request.
OPENAI_API_KEY=sk-your-openai-key-here
# Model chat yang dipakai (opsional, default gpt-3.5-turbo)
# OPENAI_CHAT_MODEL=gpt-3.5-turbo
# Model text-to-image (opsional, default dall-e-3)
# OPENAI_IMAGE_MODEL=dall-e-3

# Folder penyimpanan hasil generate media (default: backend/uploads)
# UPLOAD_DIR=uploads

# Key untuk fitur media (belum diimplementasi, siapkan jika perlu)
ELEVENLABS_API_KEY=your-elevenlabs-key-here
HUGGINGFACE_API_KEY=hf-your-huggingface-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
