# Server
PORT=3000
NODE_ENV=development

# Frontend URL (untuk CORS)
# Production: Vercel URL
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/ai-multimodal

# JWT Secret (generate: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Firebase Service Account (pilih salah satu format):
#   1. JSON string langsung (produksi, mis. Railway secret):
#      FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
#   2. Path ke file service account (lokal):
FIREBASE_SERVICE_ACCOUNT=./config/firebase-service-account.json

# Seed admin (opsional, untuk npm run seed:admin):
# ADMIN_UID=<firebase-uid>
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME="Admin"

# AI API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key-here
HUGGINGFACE_API_KEY=hf-your-huggingface-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100