# Backend Environment Variables (LOKAL - tidak ikut ter-commit)
# Panduan: docs/setup-kredensial.md

# Server
# 4000 dipakai karena port 3000 sudah terpakai proses lain di mesin ini.
PORT=4000
NODE_ENV=development

# Frontend URL (untuk CORS)
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database - ISI BARIS INI dengan connection string MongoDB Atlas Anda
# ---------------------------------------------------------------------------
# Bentuknya:
# mongodb+srv://appuser:PASSWORD@cluster0.xxxxx.mongodb.net/ai-multimodal?retryWrites=true&w=majority
#
# Ganti <password> dengan password database user, dan sisipkan nama database
# (disarankan: ai-multimodal) sebelum tanda "?".
MONGODB_URI=mongodb://127.0.0.1:27017/ai-multimodal

# JWT Secret (sudah di-generate acak, aman untuk dev)
JWT_SECRET=mvKJ7SWMpd9WaUCoA7QdgpABo96UpzsEaeHAvDVvOps=

# Firebase Service Account - butuh file backend/config/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=./config/firebase-service-account.json

# Seed admin (dipakai oleh `npm run seed:admin`) - isi setelah punya Firebase UID
# ADMIN_UID=
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME="Admin"

